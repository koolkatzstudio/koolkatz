---
/**
 * Home split portfolios (BRIEF §8). PORTFOLIO TUNI | PORTFOLIO ANY.
 * Each side is a collage/feed of covers from that person's featured
 * projects — an atmosphere/teaser, not readable individual projects.
 *
 * Initial state: B/W + visible blur. Desktop hover: color reveals, the
 * BLUR STAYS (works are never fully revealed on the Home). Click → the
 * individual portfolio. Touch devices: color reveals when the block
 * reaches the viewport's center band while scrolling, with an explicit
 * ENTER cue — no double-tap (approved decision).
 *
 * While no real projects exist, the collage renders clearly-labeled
 * placeholder tiles; real covers (featured: true) slot in automatically.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');

const sides = [
  { key: 'tuni', name: 'TUNI', href: '/tuni' },
  { key: 'any', name: 'ANY', href: '/any' },
] as const;

const coversFor = (key: 'tuni' | 'any') => {
  const own = projects
    .filter((p) => p.data.cover && (p.data.owner === key || p.data.owner === 'both'))
    .sort((a, b) => a.data.order - b.data.order);
  // Curated `featured` covers when marked; otherwise the first covers by order
  const featured = own.filter((p) => p.data.featured);
  return (featured.length ? featured : own).slice(0, 6);
};

/* Editorial span pattern for the 6 collage cells (6-col grid) */
const cells = [
  { col: 'span 4', row: 'span 3', tilt: '-0.4deg' },
  { col: 'span 2', row: 'span 2', tilt: '0.6deg' },
  { col: 'span 2', row: 'span 3', tilt: '0deg' },
  { col: 'span 2', row: 'span 2', tilt: '0.5deg' },
  { col: 'span 2', row: 'span 2', tilt: '-0.6deg' },
  { col: 'span 4', row: 'span 2', tilt: '0.3deg' },
];
---

<section class="split" id="portfolios" aria-label="Portfolios">
  {
    sides.map((side) => {
      const covers = coversFor(side.key);
      return (
        <a class="side" href={side.href} data-side={side.key}>
          <div class="collage" aria-hidden="true">
            {cells.map((cell, i) => {
              const cover = covers[i];
              return (
                <div
                  class:list={['tile', { 'tile--ph': !cover }]}
                  style={`--col: ${cell.col}; --row: ${cell.row}; --tilt: ${cell.tilt}; --d: ${i * 40}ms`}
                >
                  {cover ? (
                    <Image
                      src={cover.data.cover}
                      alt=""
                      widths={[400, 700]}
                      sizes="(max-width: 48rem) 90vw, 45vw"
                    />
                  ) : (
                    <span class="ph-label">Placeholder · project cover</span>
                  )}
                </div>
              );
            })}
          </div>

          <div class="side-front">
            <p class="side-kicker">Portfolio</p>
            <h2 class="side-name">{side.name}</h2>
            <span class="side-enter">
              Enter <span class="arrow" aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      );
    })
  }
</section>

<style>
  .split {
    display: grid;
    background: var(--color-bg);
  }

  .side {
    position: relative;
    display: grid;
    min-height: 78svh;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-black);
  }

  /* ---- Collage: the visual universe behind each name ---- */
  .collage {
    position: absolute;
    inset: -4%; /* bleeds past the edges — blur never shows a hard rim */
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(0, 1fr);
    grid-auto-flow: dense;
    gap: 6px;
    filter: var(--treatment-teaser);
    transition:
      filter 0.6s var(--ease-in-out),
      scale 0.6s var(--ease-in-out);
    scale: 1.01;
  }

  .tile {
    grid-column: var(--col);
    grid-row: var(--row);
    rotate: var(--tilt);
    overflow: hidden;
    background: #101010;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder tiles: muted tinted surfaces, clearly labeled.
     Grayscale flattens them; the reveal shows only a faint tint. */
  .tile--ph {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #202020 0%, #191919 55%, #1d1a1c 100%);
  }

  .tile--ph:nth-child(odd) {
    background: linear-gradient(200deg, #1c1c1c 0%, #191b1b 60%, #161616 100%);
  }

  .ph-label {
    font-size: 0.5625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.28);
    text-align: center;
    padding: 0.5rem;
  }

  /* Legibility scrim between collage and title */
  .side::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(6 6 6 / 0.55) 0%, rgb(6 6 6 / 0.15) 65%);
    pointer-events: none;
  }

  /* ---- Foreground: title + enter cue ---- */
  .side-front {
    position: relative;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
    padding: clamp(2rem, 6vw, 4rem);
  }

  .side-kicker {
    font-family: var(--font-structure);
    font-size: var(--text-sm);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.75;
  }

  .side-name {
    font-family: var(--font-impact);
    font-weight: 800;
    font-size: clamp(3.25rem, 2rem + 8vw, 8rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-white);
    transition: letter-spacing 0.5s var(--ease-out);
  }

  .side-enter {
    margin-top: 1.25rem;
    font-family: var(--font-structure);
    font-size: 0.8125rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-white);
    border: 1px solid rgb(255 255 255 / 0.35);
    padding: 0.7rem 1.4rem;
    min-height: 44px; /* comfortable touch size */
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition:
      opacity var(--duration-base) var(--ease-out),
      translate var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .arrow {
    color: var(--color-accent);
  }

  /* ============ Desktop / pointer with hover ============ */
  @media (hover: hover) {
    .side-enter {
      opacity: 0;
      translate: 0 0.6rem;
    }

    .side:hover .collage,
    .side:focus-visible .collage {
      filter: var(--treatment-teaser-hover); /* color IN, blur STAYS */
      scale: 1.03;
    }

    .side:hover .side-name,
    .side:focus-visible .side-name {
      letter-spacing: 0.045em; /* the micro-hint that this is explorable */
    }

    .side:hover .side-enter,
    .side:focus-visible .side-enter {
      opacity: 1;
      translate: 0 0;
    }

    .side-enter:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  /* ============ Touch: scroll-based reveal + always-visible cue ============ */
  @media (hover: none) {
    .side-enter {
      opacity: 1;
    }

    .side.is-inview .collage {
      filter: var(--treatment-teaser-hover);
      scale: 1.03;
    }

    .side.is-inview .side-enter {
      border-color: var(--color-accent);
    }
  }

  /* ============ Layout: split on wide, stack on narrow ============ */
  @media (min-width: 48.01rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      min-height: 100svh;
    }
    /* thin seam between the two universes */
    .side + .side {
      border-left: 1px solid var(--color-black);
    }
  }

  @media (max-width: 48rem) {
    .side {
      min-height: 72svh;
    }
    .side + .side {
      border-top: 1px solid var(--color-black);
    }
  }
</style>

<script>
  // Touch equivalent of hover (approved: scroll reveal, no double-tap).
  // The color reveals when a side occupies the center band of the viewport.
  if (matchMedia('(hover: none)').matches) {
    const sides = document.querySelectorAll('[data-side]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-inview', entry.isIntersecting);
        }
      },
      { rootMargin: '-30% 0px -30% 0px' },
    );
    sides.forEach((side) => io.observe(side));
  }
</script>
