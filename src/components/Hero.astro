---
/**
 * Hero (BRIEF §6). Bg #181818 with the wall texture at ~8–10% presence.
 * One big typographic protagonist (Agrandir Grand), lots of air.
 * Copy comes from site.heroCopy — temporary placeholder, not final.
 */
import { site } from '../data/site';
import wallTexture from '../assets/textures/wall-texture.jpg';

// "LET'S CREATE" → two staggered lines for an asymmetric composition.
const [firstWord, ...rest] = site.heroCopy.split(' ');
const restLine = rest.join(' ');
---

<section class="hero" style={`--wall: url(${wallTexture.src})`}>
  <div class="hero-inner container">
    <p class="kicker">KoolKatz Creative Studio</p>
    <h1 class="hero-title">
      <span class="line line-1">{firstWord}</span>
      <span class="line line-2">{restLine}<span class="accent-dot">.</span></span>
    </h1>
  </div>
  <p class="scroll-cue" aria-hidden="true">SCROLL</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Wall texture, ~9% presence — atmosphere, never a protagonist */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--wall);
    background-size: cover;
    background-position: center;
    opacity: var(--texture-opacity);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(1rem, 3vh, 2rem);
    padding-block: clamp(6rem, 18vh, 9rem);
  }

  .hero-title {
    font-family: var(--font-impact);
    font-weight: 800;
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    display: grid;
  }

  .line {
    display: block;
  }

  /* Asymmetry: second line steps in, breaking the rigid left edge */
  .line-2 {
    margin-left: clamp(2rem, 12vw, 11rem);
  }

  /* Mobile recomposition: smaller display type and a gentler step,
     so the title breathes instead of running flush to the edge.
     Desktop sizing above stays untouched. */
  @media (max-width: 48rem) {
    .hero-title {
      font-size: clamp(2.35rem, 1rem + 6.5vw, 4rem);
      line-height: 1.02;
    }
    .line-2 {
      margin-left: clamp(1.25rem, 8vw, 3.5rem);
    }
    .hero-inner {
      padding-block: clamp(5rem, 14vh, 7rem);
    }
  }

  .accent-dot {
    color: var(--color-accent);
  }

  .scroll-cue {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    right: clamp(1.25rem, 4vw, 3.5rem);
    font-family: var(--font-structure);
    font-size: 0.6875rem;
    letter-spacing: 0.34em;
    color: var(--color-white);
    opacity: 0.4;
    writing-mode: vertical-rl;
  }

  .scroll-cue::after {
    content: '';
    display: block;
    width: 1px;
    height: 2.75rem;
    margin: 0.75rem auto 0;
    background: currentColor;
    animation: cue-drop 2.4s var(--ease-in-out) infinite;
    transform-origin: top;
  }

  @keyframes cue-drop {
    0%,
    100% {
      scale: 1 0.35;
    }
    50% {
      scale: 1 1;
    }
  }
</style>
