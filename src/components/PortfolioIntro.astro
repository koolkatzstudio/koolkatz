---
/**
 * Portfolio intro (BRIEF §9). Name + short bio + discreet tools.
 * Reads the person from the `people` collection; while the real bio is
 * pending, renders clearly-labeled placeholders (PENDING_ASSETS.md).
 * Visually connected to the Home (same type system, dark base) but its
 * own composition: one massive name, bio column offset to the right.
 */
import { getCollection, render } from 'astro:content';

interface Props {
  personKey: 'tuni' | 'any';
  name: string;
}

const { personKey, name } = Astro.props;

const people = await getCollection('people');
const person = people.find((p) => p.data.contactKey === personKey);
const Bio = person ? (await render(person)).Content : null;
---

<section class="intro">
  <div class="container intro-grid">
    <div class="intro-heading">
      <p class="kicker">Portfolio</p>
      <h1 class="intro-name">{name}<span class="accent-dot">.</span></h1>
    </div>

    <div class="intro-bio">
      {
        Bio ? (
          <div class="bio-text">
            <Bio />
          </div>
        ) : (
          <p class="bio-text bio-placeholder">
            [PLACEHOLDER — {name} bio pending: who she is, what she does, creative
            interests. See PENDING_ASSETS.md]
          </p>
        )
      }
      {
        person?.data.toolGroups?.length ? (
          <div class="toolkit">
            <p class="toolkit-label">Tools</p>
            <dl class="toolkit-groups">
              {person.data.toolGroups.map((group) => (
                <div class="toolkit-group">
                  <dt>{group.label}</dt>
                  <dd>{group.items.join(' · ')}</dd>
                </div>
              ))}
            </dl>
          </div>
        ) : null /* toolkit hidden until the real list is provided */
      }
    </div>
  </div>
</section>

<style>
  .intro {
    background: var(--color-bg);
    padding-block: clamp(7rem, 22vh, 12rem) clamp(2.5rem, 7vh, 5rem);
  }

  .intro-grid {
    display: grid;
    gap: clamp(1.75rem, 5vh, 3rem);
  }

  .intro-heading {
    display: grid;
    gap: 0.75rem;
  }

  .intro-name {
    font-family: var(--font-impact);
    font-weight: 800;
    font-size: clamp(3.5rem, 2rem + 11vw, 10rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .accent-dot {
    color: var(--color-accent);
  }

  .intro-bio {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .bio-text {
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .bio-placeholder {
    color: rgb(255 255 255 / 0.45);
    border: 1px dashed rgb(255 255 255 / 0.2);
    padding: 1rem 1.25rem;
  }

  /* Toolkit: discreet metadata, never a CV (BRIEF §9) */
  .toolkit {
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    padding-top: 1.1rem;
  }

  .toolkit-label {
    font-family: var(--font-structure);
    font-size: 0.6875rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent); /* the single pink accent in this block */
  }

  .toolkit-groups {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.25rem;
  }

  .toolkit-group {
    display: grid;
    gap: 0.25rem;
  }

  .toolkit-group dt {
    font-family: var(--font-structure);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .toolkit-group dd {
    margin: 0;
    font-family: var(--font-structure);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.8;
    color: var(--color-white);
  }

  /* Desktop: bio steps right, off the name's axis — the grid exists
     without being rigid (BRAND.md §6) */
  @media (min-width: 60rem) {
    .intro-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
    .intro-bio {
      padding-bottom: 0.75rem;
    }
  }
</style>
